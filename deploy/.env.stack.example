# Plantilla para el archivo real, que vive SOLO en el servidor
# (~/gabriela-mistral/app/deploy/.env, dueño gm-deploy, modo 600) --
# nunca se commitea a git. run-deploy.sh lo resuelve con envsubst antes
# de pasarle el stack a Docker.

APP_NAME="Sistema Gabriela Mistral"
APP_URL=http://76.13.166.178:8080
APP_KEY=

DB_DATABASE=sistema_gabriela_mistral
DB_USERNAME=gabriela_mistral
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SMTP de prueba (Mailtrap Email Testing u otro) -- el mail no sale de
# ahi, es justamente para poder verificar el envio sin arriesgarse a
# mandarle un correo de prueba a un tutor real.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=libretas@sistema-gabriela-mistral.test
